# === REQUIRED — fill these 5 in, everything below has a working default ===

# --- Twilio (WhatsApp Sandbox) --- [REQUIRED]
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Copy from your Sandbox page, including the prefix, e.g. whatsapp:+14155238886
TWILIO_WHATSAPP_NUMBER=

# --- Speech + LLM (OpenAI-compatible API; Groq by default) --- [REQUIRED]
AI_API_KEY=

# --- Stripe (TEST MODE ONLY: must start with sk_test_ or rk_test_) --- [REQUIRED]
STRIPE_SECRET_KEY=

# --- Server --- [REQUIRED once your ngrok/tunnel is running]
# Public tunnel URL, no trailing slash, e.g. https://abcd1234.ngrok-free.app
# Only enforced if VALIDATE_TWILIO_SIGNATURE=true, but set it to match your tunnel anyway.
WEBHOOK_BASE_URL=

# === OPTIONAL — defaults already shown below ===

PORT=3000
VALIDATE_TWILIO_SIGNATURE=false

AI_BASE_URL=https://api.groq.com/openai/v1
TRANSCRIPTION_MODEL=whisper-large-v3-turbo
EXTRACTION_MODEL=llama-3.3-70b-versatile
# OpenAI alternative: AI_BASE_URL=https://api.openai.com/v1, TRANSCRIPTION_MODEL=whisper-1, EXTRACTION_MODEL=gpt-4o-mini

STRIPE_CURRENCY=usd
INVOICE_DAYS_UNTIL_DUE=7
# Name printed as the issuer on the invoice document
BUSINESS_NAME=Your Business
# Optional: your first name, used only for the dashboard greeting
OPERATOR_NAME=
# Optional: an address you control. Used as the email for all demo customers.
DEMO_CUSTOMER_EMAIL=

# --- Guardrails / storage ---
MAX_INVOICE_AMOUNT=10000
MAX_HOURS_LOGGED=24
ALLOW_TEXT_INPUT=false
JOBS_FILE=data/jobs.jsonl
